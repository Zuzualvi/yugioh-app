{
  "name": "yugioh-app-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand",
    "test:verbose": "node --experimental-vm-modules node_modules/.bin/jest --runInBand --verbose"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "@node-rs/argon2": "^2.0.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "testTimeout": 60000
  }
}
